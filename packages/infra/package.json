{
  "name": "@resume-lens/infra",
  "version": "0.2.0",
  "type": "module",
  "description": "AWS CDK infrastructure for resume-lens",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist cdk.out",
    "cdk": "cdk",
    "cdk:deploy": "cdk deploy --require-approval never",
    "cdk:deploy:all": "cdk deploy --all --require-approval never",
    "cdk:destroy": "cdk destroy --force",
    "cdk:destroy:all": "cdk destroy --all --force",
    "precdk:synth": "npm run build",
    "cdk:synth": "cdk synth"
  },
  "dependencies": {},
  "devDependencies": {
    "aws-cdk": "2.1143.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1"
  }
}
